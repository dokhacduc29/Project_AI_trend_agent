# =====================================================================
# .gitignore — Danh sách file/thư mục BỊ CẤM đưa lên GitHub
# =====================================================================
# TẠI SAO CẦN FILE NÀY?
# Nếu không có .gitignore, Git sẽ đẩy TOÀN BỘ file lên GitHub,
# bao gồm cả file .env chứa API Key bí mật của bạn.
# Hacker sẽ lấy key đó đi xài miễn phí hoặc tệ hơn là phá hoại tài khoản.

# 1. BẢO MẬT: Không bao giờ đẩy file chứa mật khẩu / API Key
.env

# 2. MÔI TRƯỜNG ẢO: Thư mục venv chứa hàng nghìn file thư viện (rất nặng)
# Người khác clone repo về sẽ tự chạy `pip install -r requirements.txt`
venv/
.venv/

# 3. CACHE PYTHON: File biên dịch tạm, không cần lưu trữ
__pycache__/
*.py[cod]
*$py.class
*.pyo

# 4. FILE DỮ LIỆU TẠM: Dữ liệu CSV/cache do Bot tạo ra (mỗi máy tự sinh)
# Dùng **/ để bắt cả Backend/data/ chứ không chỉ data/ ở gốc repo
data/*.csv
data/*.json
**/data/*.csv
**/data/*.json

# 5. IDE/EDITOR: File cấu hình riêng của từng máy
.vscode/
.idea/
*.swp
*.swo

# 6. HỆ ĐIỀU HÀNH: File rác của Windows/Mac
Thumbs.db
.DS_Store

# 7. AI AGENT LOCAL BRAIN: Giữ lại trên GitHub vì đây là tài liệu dự án
# .agents/   ← KHÔNG bỏ vào gitignore vì muốn chia sẻ quy tắc code

# 8. K8s SECRETS: Chứa API keys thật (base64) — KHÔNG commit
k8s/01-secret.yaml

# 9. DATA & TEST files
Backend/data/
Backend/quick_test.py
Backend/test_supabase_connection.py

# 10. GIT WORKTREES do Claude Code tạo: bản sao cục bộ của repo, KHÔNG phải mã nguồn
# Từng có 54 file của một worktree cũ bị commit nhầm — untrack ở commit này.
.claude/worktrees/

# 11. TEST ARTIFACTS: báo cáo coverage sinh khi chạy pytest
.coverage
.pytest_cache/
htmlcov/

# --- Build artifacts (ADR 0014: pyproject + src-layout) ---
build/
dist/
*.egg-info/
*.whl

# File tam tu phien lam viec, khong thuoc du an
claudeignore_run.txt
