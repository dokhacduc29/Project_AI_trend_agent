apiVersion: v1
kind: Secret
metadata:
  name: ai-trend-agent-secrets
  namespace: ai-trend-agent
type: Opaque
data:
  # Encode bằng: echo -n "your_value" | base64
  # KHÔNG commit file đã điền giá trị thật — file này chỉ là template.
  # Cách tạo secret THẬT (đọc thẳng từ Backend/.env, không ghi ra file):
  #   kubectl create secret generic ai-trend-agent-secrets -n ai-trend-agent \
  #     --from-literal=NEWS_API_KEY=... (xem README/ADR 0011)
  NEWS_API_KEY: <base64_encoded_news_api_key>
  GEMINI_API_KEY: <base64_encoded_gemini_api_key>
  SUPABASE_URL: <base64_encoded_supabase_url>
  SUPABASE_KEY: <base64_encoded_supabase_secret_key>   # sb_secret_... (ADR 0010), KHÔNG phải anon
  DISCORD_WEBHOOK_URL: <base64_encoded_discord_webhook_url>  # publisher đọc từ env (discord_agent.py)
