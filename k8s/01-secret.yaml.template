apiVersion: v1
kind: Secret
metadata:
  name: ai-trend-agent-secrets
  namespace: ai-trend-agent
type: Opaque
data:
  # Encode bằng: echo -n "your_value" | base64
  NEWS_API_KEY: <base64_encoded_news_api_key>
  GEMINI_API_KEY: <base64_encoded_gemini_api_key>
  SUPABASE_URL: <base64_encoded_supabase_url>
  SUPABASE_KEY: <base64_encoded_supabase_anon_key>
